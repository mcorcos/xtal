// Shared.xcconfig
// Minimal shared configuration for scaffold tool customization
// All other settings use Xcode project defaults
// Generated by XcodeBuildMCP

// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = Xtal
PRODUCT_DISPLAY_NAME = Xtal
PRODUCT_BUNDLE_IDENTIFIER = com.unit.xtal
// La version de la app va clavada a la del workspace de Rust (Cargo.toml).
// El job `check` de .github/workflows/release.yml no publica si no coinciden:
// una app que dice 0.1.0 hablándole a una CLI 0.3.2 no se puede diagnosticar.
MARKETING_VERSION = 0.6.0
CURRENT_PROJECT_VERSION = 1

// ==========================================
// Platform Configuration
// ==========================================
MACOSX_DEPLOYMENT_TARGET = 15.0

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = YES
// Xcode genera el Info.plist, pero no sabe generar el esquema de URL: eso se declara
// a mano acá y Xcode mezcla lo suyo adentro de este archivo.
INFOPLIST_FILE = Config/Info.plist

// ==========================================
// Entitlements
// ==========================================
// AI agents can modify Config/Xtal.entitlements to add capabilities
CODE_SIGN_ENTITLEMENTS = Config/Xtal.entitlements